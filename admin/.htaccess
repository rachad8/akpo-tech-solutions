# ============================================
# ADMIN - Fichier .htaccess
# Protection du panneau d'administration
# ============================================

# Bloquer l'accès public au dossier admin
Order Deny,Allow
Deny from all

# Autoriser l'accès depuis le site (pour les redirections)
# Allow from 127.0.0.1

# OU utiliser l'authentification par mot de passe
# AuthType Basic
# AuthName "Accès administrateur - AKPO TECH"
# AuthUserFile /home/akpotechsolutions/.htpasswd-admin
# Require valid-user

# Empêcher le listing des fichiers
Options -Indexes

# Bloquer l'accès aux fichiers sensibles dans admin
<FilesMatch "^(\.env|\.htaccess|\.htpasswd|config\.php|config\.js|settings\.php|settings\.js|database\.php|database\.js)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Rediriger les tentatives d'accès direct aux fichiers
<Files ~ "\.(php|ini|log|sql|db|sh|pl|py)$">
    Order Allow,Deny
    Deny from all
</Files>