{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "source": "../functions",
      "codebase": "default"
    },
    {
      "source": "../functions-fedapay",
      "codebase": "payments"
    }
  ]
}
