rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un administrateur est identifie par le champ role du document clients/{uid}.
    // Le custom claim token.admin reste accepte pour compatibilite.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/clients/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

        // Le formulaire admin public crée directement son profil admin après inscription Firebase.
    function keepsOwnRole() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }


    match /commentaires/{commentId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /contacts/{messageId} {
      allow get: if isAdmin();
      allow list: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /clients/{userId} {
      // Sans Cloud Function, le rôle admin est stocké dans le profil. Les requêtes
      // de liste doivent donc être autorisées pour les utilisateurs authentifiés.
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isOwner(userId) && keepsOwnRole());
      allow delete: if isAdmin();

        match /demandes/{demandeId} {
        allow get: if isAdmin() || isOwner(userId);
        allow list: if isAuthenticated();
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    match /factures/{factureId} {
      allow get: if isAdmin() || isOwner(resource.data.clientId);
      allow list: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}